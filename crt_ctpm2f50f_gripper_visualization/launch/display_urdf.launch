<launch>
  <arg
    name="model" />
  <param
    name="robot_description"
    textfile="$(find crt_ctpm2f50f_gripper_visualization)/urdf/crt_ctpm2f50f.urdf" />
  <node
    name="joint_state_publisher_gui"
    pkg="joint_state_publisher_gui"
    type="joint_state_publisher_gui" />
  <node
    name="robot_state_publisher"
    pkg="robot_state_publisher"
    type="robot_state_publisher" />
  <node
    name="rviz"
    pkg="rviz"
    type="rviz"
    args="-d $(find crt_ctpm2f50f_gripper_visualization)/urdf.rviz" />
</launch>
